{
  "name": "medly",
  "version": "1.0.0",
  "private": true,
  "description": "Medly AI Application",
  "main": "electron/main.js",
  "author": "Your Name",
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.your-company.medly",
    "productName": "Medly",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend_deploy",
        "to": "backend_deploy",
        "filter": [
          "**/*",
          "!model/**/*",
          "!**/__pycache__",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "backend/static/tiger-nurse.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "backend/static/tiger-nurse.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "backend/static/tiger-nurse.png"
    }
  }
}